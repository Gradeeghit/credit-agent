<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.credit.agent</groupId>
    <artifactId>credit-agent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>credit-agent</name>
    <description>信贷申请智能审批助手 - AI辅助初审, 算钱不用AI</description>

    <modules>
        <module>domain</module>
        <module>infra</module>
        <module>rag</module>
        <module>tool</module>
        <module>agent</module>
        <module>orchestration</module>
        <module>api</module>
        <module>config</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <!-- 默认排除 @Tag("live") 的用例(会真实调外部 API); 需跑时传 -Dsurefire.excludedGroups=noop -->
        <surefire.excludedGroups>live</surefire.excludedGroups>
        <!-- Spring AI 1.1.x 按 Spring Boot 3.5.x 编译, 必须与上方 parent 的 3.5 大版本对齐 -->
        <spring-ai.version>1.1.6</spring-ai.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <pdfbox.version>3.0.4</pdfbox.version>
        <jieba.version>1.0.2</jieba.version>
        <!-- 覆盖率: 只用 JaCoCo, 不引入 checkstyle/pmd/spotbugs -->
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI BOM: 统一管理 spring-ai-* 版本, 避免版本冲突 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部模块统一版本: 子模块互相依赖时不再写 <version> -->
            <dependency>
                <groupId>com.credit.agent</groupId>
                <artifactId>credit-agent-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.credit.agent</groupId>
                <artifactId>credit-agent-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.credit.agent</groupId>
                <artifactId>credit-agent-rag</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.credit.agent</groupId>
                <artifactId>credit-agent-tool</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.credit.agent</groupId>
                <artifactId>credit-agent-agent</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.credit.agent</groupId>
                <artifactId>credit-agent-orchestration</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.credit.agent</groupId>
                <artifactId>credit-agent-config</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.credit.agent</groupId>
                <artifactId>credit-agent-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <dependency>
                <groupId>com.huaban</groupId>
                <artifactId>jieba-analysis</artifactId>
                <version>${jieba.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 全部模块统一继承, 子模块不再重复声明 lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 带 @Tag("live") 的用例会真实调外部服务(embedding API), 默认不跑,
                 保持 mvn test 全绿 0 跳过; 需要时用 -Dgroups=live 显式开启 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- 用属性包一层: 需要跑 live 用例时传 -Dsurefire.excludedGroups=<不存在的tag> 即可放行 -->
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>

            <!-- 覆盖率: prepare-agent 默认绑定 initialize, 必须早于 surefire 挂上 agent
                 (否则 report 会报 "missing execution data file"); report 绑定 test 阶段 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
